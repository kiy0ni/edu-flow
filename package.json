{
  "name": "eduflow",
  "version": "2.0.0",
  "private": true,
  "description": "EduFlow - espace numerique de travail scolaire",
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "npm run dev --workspace=backend & npm run dev --workspace=frontend",
    "dev:api": "npm run dev --workspace=backend",
    "dev:web": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "migrate": "npm run migrate --workspace=backend",
    "test": "npm test --workspace=backend",
    "docker": "docker compose up --build"
  },
  "engines": { "node": ">=20" }
}
