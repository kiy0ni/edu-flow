# ---- Serveur ----
PORT=4000
NODE_ENV=development
# Origines autorisees pour le front (separees par des virgules)
CORS_ORIGINS=http://localhost:5173

# ---- Base de donnees ----
DATABASE_URL=postgres://eduflow:eduflow@localhost:5432/eduflow
# Mettre a true si la base exige TLS (Neon, Supabase, Render...)
DATABASE_SSL=false

# ---- Securite ----
# openssl rand -hex 48
JWT_SECRET=
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=30d
# Cle AES-256 (64 caracteres hex) pour chiffrer les jetons Ecole Directe au repos
# openssl rand -hex 32
ENCRYPTION_KEY=

# ---- Ecole Directe ----
ECOLEDIRECTE_API_BASE_URL=https://api.ecoledirecte.com
ECOLEDIRECTE_API_VERSION=4.75.0
# Autoriser le mode demonstration (compte fictif, aucune donnee reelle)
ALLOW_DEMO_ACCOUNTS=true

# ---- IA (optionnel : sans cle, les fonctions IA sont desactivees proprement) ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=medium
AI_DAILY_MESSAGE_LIMIT=80
