# Variables utilisees par docker-compose a la racine du projet.

# openssl rand -hex 48
JWT_SECRET=
# openssl rand -hex 32
ENCRYPTION_KEY=
# Mot de passe de la base
POSTGRES_PASSWORD=eduflow

# Origine autorisee pour le front (celle a laquelle les navigateurs accedent)
CORS_ORIGINS=http://localhost:8080

# Comptes de demonstration (donnees fictives)
ALLOW_DEMO_ACCOUNTS=true

# Assistant IA - optionnel. Sans cle, l'application fonctionne sans l'assistant.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
